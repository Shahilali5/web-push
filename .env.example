PORT=3050
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=push_system
REDIS_URL=redis://127.0.0.1:6379

# secrets (use long random strings)
ADMIN_KEY=change-me-admin
SITE_KEY=change-me-site

# Firebase
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
VAPID_KEY=your-web-push-certificate-key-pair
FIREBASE_WEB_CONFIG={"apiKey":"","authDomain":"","projectId":"","messagingSenderId":"","appId":""}

# welcome notification
WELCOME_TITLE=Thanks For Subscribing
WELCOME_BODY=You Will Receive Updates Even When Website Is Closed
WELCOME_URL=/test/
WORKER_CONCURRENCY=5
